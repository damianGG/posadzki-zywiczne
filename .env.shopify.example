# Add these in Vercel Project Settings -> Environment Variables.
# Never commit real token values. Configure on Preview first.
# The Shopify domain must be an exact *.myshopify.com hostname.
SHOPIFY_STORE_DOMAIN=twoj-sklep.myshopify.com
# Public Storefront token from Shopify's Headless sales channel (stored server-side).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-public-token
# Optional: only if Shopify uses a custom checkout domain.
# SHOPIFY_CHECKOUT_DOMAIN=checkout.twoja-domena.pl

# Production: leave unset/false until the go-live decision.
SHOP_ENABLED=false

# On Vercel Preview, only branch feature/shopify-store is enabled automatically.
# All preview deployments should remain protected by Vercel Authentication.
